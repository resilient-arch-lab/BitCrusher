1966:Inc/CMSIS/Core/Include/core_cm4.h **** /**
1967:Inc/CMSIS/Core/Include/core_cm4.h ****   \ingroup  CMSIS_Core_FunctionInterface
1968:Inc/CMSIS/Core/Include/core_cm4.h ****   \defgroup CMSIS_Core_FpuFunctions FPU Functions
1969:Inc/CMSIS/Core/Include/core_cm4.h ****   \brief    Function that provides FPU type.
1970:Inc/CMSIS/Core/Include/core_cm4.h ****   @{
1971:Inc/CMSIS/Core/Include/core_cm4.h ****  */
1972:Inc/CMSIS/Core/Include/core_cm4.h **** 
1973:Inc/CMSIS/Core/Include/core_cm4.h **** /**
1974:Inc/CMSIS/Core/Include/core_cm4.h ****   \brief   get FPU type
1975:Inc/CMSIS/Core/Include/core_cm4.h ****   \details returns the FPU type
1976:Inc/CMSIS/Core/Include/core_cm4.h ****   \returns
1977:Inc/CMSIS/Core/Include/core_cm4.h ****    - \b  0: No FPU
1978:Inc/CMSIS/Core/Include/core_cm4.h ****    - \b  1: Single precision FPU
1979:Inc/CMSIS/Core/Include/core_cm4.h ****    - \b  2: Double + Single precision FPU
1980:Inc/CMSIS/Core/Include/core_cm4.h ****  */
1981:Inc/CMSIS/Core/Include/core_cm4.h **** __STATIC_INLINE uint32_t SCB_GetFPUType(void)
1982:Inc/CMSIS/Core/Include/core_cm4.h **** {
1983:Inc/CMSIS/Core/Include/core_cm4.h ****   uint32_t mvfr0;
1984:Inc/CMSIS/Core/Include/core_cm4.h **** 
1985:Inc/CMSIS/Core/Include/core_cm4.h ****   mvfr0 = FPU->MVFR0;
1986:Inc/CMSIS/Core/Include/core_cm4.h ****   if      ((mvfr0 & (FPU_MVFR0_Single_precision_Msk | FPU_MVFR0_Double_precision_Msk)) == 0x020U)
1987:Inc/CMSIS/Core/Include/core_cm4.h ****   {
1988:Inc/CMSIS/Core/Include/core_cm4.h ****     return 1U;           /* Single precision FPU */
1989:Inc/CMSIS/Core/Include/core_cm4.h ****   }
1990:Inc/CMSIS/Core/Include/core_cm4.h ****   else
1991:Inc/CMSIS/Core/Include/core_cm4.h ****   {
1992:Inc/CMSIS/Core/Include/core_cm4.h ****     return 0U;           /* No FPU */
1993:Inc/CMSIS/Core/Include/core_cm4.h ****   }
1994:Inc/CMSIS/Core/Include/core_cm4.h **** }
