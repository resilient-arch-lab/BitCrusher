1905:Inc/CMSIS/Core/Include/core_cm4.h ****   \brief   Set Interrupt Vector
1906:Inc/CMSIS/Core/Include/core_cm4.h ****   \details Sets an interrupt vector in SRAM based interrupt vector table.
1907:Inc/CMSIS/Core/Include/core_cm4.h ****            The interrupt number can be positive to specify a device specific interrupt,
1908:Inc/CMSIS/Core/Include/core_cm4.h ****            or negative to specify a processor exception.
1909:Inc/CMSIS/Core/Include/core_cm4.h ****            VTOR must been relocated to SRAM before.
1910:Inc/CMSIS/Core/Include/core_cm4.h ****   \param [in]   IRQn      Interrupt number
1911:Inc/CMSIS/Core/Include/core_cm4.h ****   \param [in]   vector    Address of interrupt handler function
1912:Inc/CMSIS/Core/Include/core_cm4.h ****  */
1913:Inc/CMSIS/Core/Include/core_cm4.h **** __STATIC_INLINE void __NVIC_SetVector(IRQn_Type IRQn, uint32_t vector)
1914:Inc/CMSIS/Core/Include/core_cm4.h **** {
1915:Inc/CMSIS/Core/Include/core_cm4.h ****   uint32_t *vectors = (uint32_t *)SCB->VTOR;
1916:Inc/CMSIS/Core/Include/core_cm4.h ****   vectors[(int32_t)IRQn + NVIC_USER_IRQ_OFFSET] = vector;
1917:Inc/CMSIS/Core/Include/core_cm4.h **** }
