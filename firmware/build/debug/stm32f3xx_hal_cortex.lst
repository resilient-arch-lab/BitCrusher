1683:Inc/CMSIS/Core/Include/core_cm4.h ****   \brief   Enable Interrupt
1684:Inc/CMSIS/Core/Include/core_cm4.h ****   \details Enables a device specific interrupt in the NVIC interrupt controller.
1685:Inc/CMSIS/Core/Include/core_cm4.h ****   \param [in]      IRQn  Device specific interrupt number.
1686:Inc/CMSIS/Core/Include/core_cm4.h ****   \note    IRQn must not be negative.
1687:Inc/CMSIS/Core/Include/core_cm4.h ****  */
1688:Inc/CMSIS/Core/Include/core_cm4.h **** __STATIC_INLINE void __NVIC_EnableIRQ(IRQn_Type IRQn)
1689:Inc/CMSIS/Core/Include/core_cm4.h **** {
1690:Inc/CMSIS/Core/Include/core_cm4.h ****   if ((int32_t)(IRQn) >= 0)
1691:Inc/CMSIS/Core/Include/core_cm4.h ****   {
1692:Inc/CMSIS/Core/Include/core_cm4.h ****     NVIC->ISER[(((uint32_t)IRQn) >> 5UL)] = (uint32_t)(1UL << (((uint32_t)IRQn) & 0x1FUL));
1693:Inc/CMSIS/Core/Include/core_cm4.h ****   }
1694:Inc/CMSIS/Core/Include/core_cm4.h **** }
1695:Inc/CMSIS/Core/Include/core_cm4.h **** 
