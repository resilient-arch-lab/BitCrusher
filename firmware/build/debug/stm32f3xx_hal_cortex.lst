1532:Inc/CMSIS/Core/Include/core_cm4.h **** */
1533:Inc/CMSIS/Core/Include/core_cm4.h **** #define _VAL2FLD(field, value)    (((uint32_t)(value) << field ## _Pos) & field ## _Msk)
1534:Inc/CMSIS/Core/Include/core_cm4.h **** 
1535:Inc/CMSIS/Core/Include/core_cm4.h **** /**
