1649:Inc/CMSIS/Core/Include/core_cm4.h ****   \brief   Set Priority Grouping
1650:Inc/CMSIS/Core/Include/core_cm4.h ****   \details Sets the priority grouping field using the required unlock sequence.
1651:Inc/CMSIS/Core/Include/core_cm4.h ****            The parameter PriorityGroup is assigned to the field SCB->AIRCR [10:8] PRIGROUP field.
1652:Inc/CMSIS/Core/Include/core_cm4.h ****            Only values from 0..7 are used.
1653:Inc/CMSIS/Core/Include/core_cm4.h ****            In case of a conflict between priority grouping and available
1654:Inc/CMSIS/Core/Include/core_cm4.h ****            priority bits (__NVIC_PRIO_BITS), the smallest possible priority group is set.
1655:Inc/CMSIS/Core/Include/core_cm4.h ****   \param [in]      PriorityGroup  Priority grouping field.
1656:Inc/CMSIS/Core/Include/core_cm4.h ****  */
1657:Inc/CMSIS/Core/Include/core_cm4.h **** __STATIC_INLINE void __NVIC_SetPriorityGrouping(uint32_t PriorityGroup)
1658:Inc/CMSIS/Core/Include/core_cm4.h **** {
1659:Inc/CMSIS/Core/Include/core_cm4.h ****   uint32_t reg_value;
1660:Inc/CMSIS/Core/Include/core_cm4.h ****   uint32_t PriorityGroupTmp = (PriorityGroup & (uint32_t)0x07UL);             /* only values 0..7 a
1661:Inc/CMSIS/Core/Include/core_cm4.h **** 
1662:Inc/CMSIS/Core/Include/core_cm4.h ****   reg_value  =  SCB->AIRCR;                                                   /* read old register 
1663:Inc/CMSIS/Core/Include/core_cm4.h ****   reg_value &= ~((uint32_t)(SCB_AIRCR_VECTKEY_Msk | SCB_AIRCR_PRIGROUP_Msk)); /* clear bits to chan
1664:Inc/CMSIS/Core/Include/core_cm4.h ****   reg_value  =  (reg_value                                   |
1665:Inc/CMSIS/Core/Include/core_cm4.h ****                 ((uint32_t)0x5FAUL << SCB_AIRCR_VECTKEY_Pos) |
1666:Inc/CMSIS/Core/Include/core_cm4.h ****                 (PriorityGroupTmp << SCB_AIRCR_PRIGROUP_Pos)  );              /* Insert write key a
1667:Inc/CMSIS/Core/Include/core_cm4.h ****   SCB->AIRCR =  reg_value;
1668:Inc/CMSIS/Core/Include/core_cm4.h **** }
1669:Inc/CMSIS/Core/Include/core_cm4.h **** 
1670:Inc/CMSIS/Core/Include/core_cm4.h **** 
1671:Inc/CMSIS/Core/Include/core_cm4.h **** /**
1672:Inc/CMSIS/Core/Include/core_cm4.h ****   \brief   Get Priority Grouping
1673:Inc/CMSIS/Core/Include/core_cm4.h ****   \details Reads the priority grouping field from the NVIC Interrupt Controller.
1674:Inc/CMSIS/Core/Include/core_cm4.h ****   \return                Priority grouping field (SCB->AIRCR [10:8] PRIGROUP field).
1675:Inc/CMSIS/Core/Include/core_cm4.h ****  */
1676:Inc/CMSIS/Core/Include/core_cm4.h **** __STATIC_INLINE uint32_t __NVIC_GetPriorityGrouping(void)
1677:Inc/CMSIS/Core/Include/core_cm4.h **** {
1678:Inc/CMSIS/Core/Include/core_cm4.h ****   return ((uint32_t)((SCB->AIRCR & SCB_AIRCR_PRIGROUP_Msk) >> SCB_AIRCR_PRIGROUP_Pos));
1679:Inc/CMSIS/Core/Include/core_cm4.h **** }
