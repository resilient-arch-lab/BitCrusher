1697:Inc/CMSIS/Core/Include/core_cm4.h **** /**
1698:Inc/CMSIS/Core/Include/core_cm4.h ****   \brief   Get Interrupt Enable status
1699:Inc/CMSIS/Core/Include/core_cm4.h ****   \details Returns a device specific interrupt enable status from the NVIC interrupt controller.
1700:Inc/CMSIS/Core/Include/core_cm4.h ****   \param [in]      IRQn  Device specific interrupt number.
1701:Inc/CMSIS/Core/Include/core_cm4.h ****   \return             0  Interrupt is not enabled.
1702:Inc/CMSIS/Core/Include/core_cm4.h ****   \return             1  Interrupt is enabled.
1703:Inc/CMSIS/Core/Include/core_cm4.h ****   \note    IRQn must not be negative.
1704:Inc/CMSIS/Core/Include/core_cm4.h ****  */
1705:Inc/CMSIS/Core/Include/core_cm4.h **** __STATIC_INLINE uint32_t __NVIC_GetEnableIRQ(IRQn_Type IRQn)
1706:Inc/CMSIS/Core/Include/core_cm4.h **** {
1707:Inc/CMSIS/Core/Include/core_cm4.h ****   if ((int32_t)(IRQn) >= 0)
1708:Inc/CMSIS/Core/Include/core_cm4.h ****   {
1709:Inc/CMSIS/Core/Include/core_cm4.h ****     return((uint32_t)(((NVIC->ISER[(((uint32_t)IRQn) >> 5UL)] & (1UL << (((uint32_t)IRQn) & 0x1FUL)
1710:Inc/CMSIS/Core/Include/core_cm4.h ****   }
1711:Inc/CMSIS/Core/Include/core_cm4.h ****   else
1712:Inc/CMSIS/Core/Include/core_cm4.h ****   {
1713:Inc/CMSIS/Core/Include/core_cm4.h ****     return(0U);
1714:Inc/CMSIS/Core/Include/core_cm4.h ****   }
1715:Inc/CMSIS/Core/Include/core_cm4.h **** }
