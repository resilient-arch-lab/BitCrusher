1805:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****       (InputTrigger == TIM_TS_ITR2) || (InputTrigger == TIM_TS_ITR3))
1806:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   {
