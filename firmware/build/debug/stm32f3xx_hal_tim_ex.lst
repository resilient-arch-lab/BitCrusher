1773:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c **** /**
1774:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   * @brief  Configure the TIM commutation event sequence.
1775:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   * @note  This function is mandatory to use the commutation event in order to
1776:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *        update the configuration at each commutation detection on the TRGI input of the Timer,
1777:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *        the typical use of this feature is with the use of another Timer(interface Timer)
1778:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *        configured in Hall sensor interface, this interface Timer will generate the
1779:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *        commutation at its TRGO output (connected to Timer used in this function) each time
1780:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *        the TI1 of the Interface Timer detect a commutation at its input TI1.
1781:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   * @param  htim TIM handle
1782:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   * @param  InputTrigger the Internal trigger corresponding to the Timer Interfacing with the Hall 
1783:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *          This parameter can be one of the following values:
1784:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *            @arg TIM_TS_ITR0: Internal trigger 0 selected
1785:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *            @arg TIM_TS_ITR1: Internal trigger 1 selected
1786:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *            @arg TIM_TS_ITR2: Internal trigger 2 selected
1787:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *            @arg TIM_TS_ITR3: Internal trigger 3 selected
1788:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *            @arg TIM_TS_NONE: No trigger is needed
1789:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   * @param  CommutationSource the Commutation Event source
1790:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *          This parameter can be one of the following values:
1791:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *            @arg TIM_COMMUTATION_TRGI: Commutation source is the TRGI of the Interface Timer
1792:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   *            @arg TIM_COMMUTATION_SOFTWARE:  Commutation source is set by software using the COMG
1793:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   * @retval HAL status
1794:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   */
1795:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c **** HAL_StatusTypeDef HAL_TIMEx_ConfigCommutEvent(TIM_HandleTypeDef *htim, uint32_t  InputTrigger,
1796:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****                                               uint32_t  CommutationSource)
1797:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c **** {
ARM GAS  /tmp/ccfhaacA.s 			page 33


1798:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   /* Check the parameters */
1799:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   assert_param(IS_TIM_COMMUTATION_EVENT_INSTANCE(htim->Instance));
1800:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c ****   assert_param(IS_TIM_INTERNAL_TRIGGEREVENT_SELECTION(InputTrigger));
1801:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_tim_ex.c **** 
