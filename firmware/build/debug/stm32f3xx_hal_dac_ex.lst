 111:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   */
 112:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c **** HAL_StatusTypeDef HAL_DAC_SetValue(DAC_HandleTypeDef* hdac, uint32_t Channel, uint32_t Alignment, u
 113:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c **** {  
 114:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   __IO uint32_t tmp = 0U;
 115:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   
 116:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   /* Check the parameters */
 117:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   assert_param(IS_DAC_CHANNEL(Channel));
 118:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   assert_param(IS_DAC_ALIGN(Alignment));
 119:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   assert_param(IS_DAC_DATA(Data));
 120:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****    
 121:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   tmp = (uint32_t) (hdac->Instance);
 122:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c **** 
 123:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c **** /* DAC 1 has 1 or 2 channels - no DAC2 */
 124:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c **** /* DAC 1 has 2 channels 1U & 2U - DAC 2 has one channel 1U */
 125:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c **** 
 126:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   if(Channel == DAC_CHANNEL_1)
 127:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   {
 128:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****     tmp += DAC_DHR12R1_ALIGNMENT(Alignment);
 129:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   }
