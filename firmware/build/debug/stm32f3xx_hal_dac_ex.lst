 132:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****     defined(STM32F303x8) || defined(STM32F334x8) || defined(STM32F328xx) || \
 133:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****     defined(STM32F373xC) || defined(STM32F378xx)
 134:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   else /* channel = DAC_CHANNEL_2  */
 135:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   {
 136:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****     tmp += DAC_DHR12R2_ALIGNMENT(Alignment);
 137:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c ****   }
 138:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_dac_ex.c **** #endif /* STM32F303xE || STM32F398xx                || */
