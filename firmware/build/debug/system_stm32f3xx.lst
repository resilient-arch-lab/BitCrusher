  79 0012 30D1     		bne	.L7
 227:Src/system_stm32f3xx.c ****   {
 228:Src/system_stm32f3xx.c ****     case RCC_CFGR_SWS_HSI:  /* HSI used as system clock */
 229:Src/system_stm32f3xx.c ****       SystemCoreClock = HSI_VALUE;
  80              		.loc 1 229 7 view .LVU11
