 147:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c **** 
 148:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c **** /**
 149:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   * @brief  Program halfword, word or double word at a specified address
 150:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   * @note   The function HAL_FLASH_Unlock() should be called before to unlock the FLASH interface
 151:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   *         The function HAL_FLASH_Lock() should be called after to lock the FLASH interface
 152:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   *
 153:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   * @note   If an erase and a program operations are requested simultaneously,    
 154:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   *         the erase operation is performed before the program one.
 155:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   *  
 156:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   * @note   FLASH should be previously erased before new programming (only exception to this 
 157:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   *         is when 0x0000 is programmed)
 158:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   *
 159:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   * @param  TypeProgram   Indicate the way to program at a specified address.
 160:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   *                       This parameter can be a value of @ref FLASH_Type_Program
 161:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   * @param  Address       Specifie the address to be programmed.
 162:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   * @param  Data          Specifie the data to be programmed
 163:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   * 
 164:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   * @retval HAL_StatusTypeDef HAL Status
 165:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   */
 166:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c **** HAL_StatusTypeDef HAL_FLASH_Program(uint32_t TypeProgram, uint32_t Address, uint64_t Data)
 167:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c **** {
 168:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   HAL_StatusTypeDef status = HAL_ERROR;
 169:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   uint8_t index = 0U;
 170:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   uint8_t nbiterations = 0U;
 171:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   
 172:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   /* Process Locked */
 173:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   __HAL_LOCK(&pFlash);
 174:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c **** 
 175:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   /* Check the parameters */
 176:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   assert_param(IS_FLASH_TYPEPROGRAM(TypeProgram));
 177:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   assert_param(IS_FLASH_PROGRAM_ADDRESS(Address));
 178:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c **** 
 179:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****     /* Wait for last operation to be completed */
 180:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****     status = FLASH_WaitForLastOperation(FLASH_TIMEOUT_VALUE);
 181:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   
 182:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   if(status == HAL_OK)
 183:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****   {
 184:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****     if(TypeProgram == FLASH_TYPEPROGRAM_HALFWORD)
 185:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****     {
 186:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****       /* Program halfword (16-bit) at a specified address. */
 187:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****       nbiterations = 1U;
 188:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****     }
 189:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****     else if(TypeProgram == FLASH_TYPEPROGRAM_WORD)
 190:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****     {
 191:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****       /* Program word (32-bit = 2*16-bit) at a specified address. */
 192:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****       nbiterations = 2U;
 193:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****     }
 194:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****     else
 195:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****     {
 196:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash.c ****       /* Program double word (64-bit = 4*16-bit) at a specified address. */
