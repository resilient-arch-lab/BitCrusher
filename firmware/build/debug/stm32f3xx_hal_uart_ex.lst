 124:Inc/CMSIS/Core/Include/cmsis_gcc.h **** /**
 125:Inc/CMSIS/Core/Include/cmsis_gcc.h ****   \brief   Enable IRQ Interrupts
 126:Inc/CMSIS/Core/Include/cmsis_gcc.h ****   \details Enables IRQ interrupts by clearing the I-bit in the CPSR.
 127:Inc/CMSIS/Core/Include/cmsis_gcc.h ****            Can only be executed in Privileged modes.
 128:Inc/CMSIS/Core/Include/cmsis_gcc.h ****  */
 129:Inc/CMSIS/Core/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE void __enable_irq(void)
 130:Inc/CMSIS/Core/Include/cmsis_gcc.h **** {
 131:Inc/CMSIS/Core/Include/cmsis_gcc.h ****   __ASM volatile ("cpsie i" : : : "memory");
 132:Inc/CMSIS/Core/Include/cmsis_gcc.h **** }
 133:Inc/CMSIS/Core/Include/cmsis_gcc.h **** 
 134:Inc/CMSIS/Core/Include/cmsis_gcc.h **** 
 135:Inc/CMSIS/Core/Include/cmsis_gcc.h **** /**
 136:Inc/CMSIS/Core/Include/cmsis_gcc.h ****   \brief   Disable IRQ Interrupts
 137:Inc/CMSIS/Core/Include/cmsis_gcc.h ****   \details Disables IRQ interrupts by setting the I-bit in the CPSR.
