  89:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** /** @defgroup HAL_Exported_Functions_Group1 Initialization and de-initialization Functions 
  90:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****  *  @brief    Initialization and de-initialization functions
  91:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****  *
  92:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** @verbatim
  93:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****  ===============================================================================
  94:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****               ##### Initialization and de-initialization functions #####
  95:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****  ===============================================================================
  96:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****     [..]  This section provides functions allowing to:
  97:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****       (+) Initializes the Flash interface, the NVIC allocation and initial clock 
  98:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****           configuration. It initializes the systick also when timeout is needed
  99:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****           and the backup domain when enabled.
 100:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****       (+) de-Initializes common part of the HAL.
 101:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****       (+) Configure The time base source to have 1ms time base with a dedicated 
 102:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****           Tick interrupt priority. 
 103:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****         (++) SysTick timer is used by default as source of time base, but user 
 104:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****              can eventually implement his proper time base source (a general purpose 
 105:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****              timer for example or other time source), keeping in mind that Time base 
 106:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****              duration should be kept 1ms since PPP_TIMEOUT_VALUEs are defined and 
 107:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****              handled in milliseconds basis.
 108:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****         (++) Time base configuration function (HAL_InitTick ()) is called automatically 
 109:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****              at the beginning of the program after reset by HAL_Init() or at any time 
 110:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****              when clock is configured, by HAL_RCC_ClockConfig(). 
 111:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****         (++) Source of time base is configured  to generate interrupts at regular 
 112:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****              time intervals. Care must be taken if HAL_Delay() is called from a 
 113:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****              peripheral ISR process, the Tick interrupt line must have higher priority 
 114:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****             (numerically lower) than the peripheral interrupt. Otherwise the caller 
 115:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****             ISR process will be blocked. 
 116:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****        (++) functions affecting time base configurations are declared as __Weak  
 117:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****              to make  override possible  in case of other  implementations in user file.
 118:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** 
 119:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** @endverbatim
 120:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   * @{
 121:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   */
 122:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** 
 123:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** /**
 124:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   * @brief  This function configures the Flash prefetch, 
 125:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   *         Configures time base source, NVIC and Low level hardware
 126:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   * @note   This function is called at the beginning of program after reset and before 
 127:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   *         the clock configuration
 128:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   *             
 129:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   * @note   The Systick configuration is based on HSI clock, as HSI is the clock
 130:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   *         used after a system Reset and the NVIC configuration is set to Priority group 4 
 131:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   *            
 132:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   * @note   The time base configuration is based on MSI clock when exiting from Reset.
 133:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   *         Once done, time base tick start incrementing.
 134:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   *         In the default implementation,Systick is used as source of time base.
 135:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   *       The tick variable is incremented each 1ms in its ISR.
 136:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   * @retval HAL status
 137:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   */
 138:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** HAL_StatusTypeDef HAL_Init(void)
 139:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** {
 140:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   /* Configure Flash prefetch */
 141:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** #if (PREFETCH_ENABLE != 0U)
 142:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   __HAL_FLASH_PREFETCH_BUFFER_ENABLE();
 143:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** #endif /* PREFETCH_ENABLE */
 144:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** 
ARM GAS  /tmp/cc44h6vj.s 			page 4


 145:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   /* Set Interrupt Group Priority */
 146:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   HAL_NVIC_SetPriorityGrouping(NVIC_PRIORITYGROUP_4);
 147:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** 
 148:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   /* Enable systick and configure 1ms tick (default clock after Reset is HSI) */
 149:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   HAL_InitTick(TICK_INT_PRIORITY);
 150:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** 
 151:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   /* Init the low level hardware */
 152:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   HAL_MspInit();
 153:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** 
 154:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   /* Return function status */
 155:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c ****   return HAL_OK;
 156:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal.c **** }
