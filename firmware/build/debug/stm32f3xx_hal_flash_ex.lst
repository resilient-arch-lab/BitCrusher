 117:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** /** @defgroup FLASHEx_Exported_Functions_Group1 FLASHEx Memory Erasing functions
 118:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****  *  @brief   FLASH Memory Erasing functions
 119:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****  *
 120:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** @verbatim
 121:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   ==============================================================================
 122:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****                 ##### FLASH Erasing Programming functions #####
 123:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   ==============================================================================
 124:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** 
 125:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****     [..] The FLASH Memory Erasing functions, includes the following functions:
 126:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****     (+) HAL_FLASHEx_Erase: return only when erase has been done
 127:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****     (+) HAL_FLASHEx_Erase_IT: end of erase is done when HAL_FLASH_EndOfOperationCallback
 128:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****         is called with parameter 0xFFFFFFFF
 129:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** 
 130:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****     [..] Any operation of erase should follow these steps:
 131:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****     (#) Call the HAL_FLASH_Unlock() function to enable the flash control register and
 132:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****         program memory access.
 133:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****     (#) Call the desired function to erase page.
 134:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****     (#) Call the HAL_FLASH_Lock() to disable the flash program memory access
 135:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****        (recommended to protect the FLASH memory against possible unwanted operation).
 136:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** 
 137:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** @endverbatim
 138:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   * @{
 139:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   */
 140:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** 
 141:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** 
 142:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** /**
 143:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   * @brief  Perform a mass erase or erase the specified FLASH memory pages
 144:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   * @note   To correctly run this function, the @ref HAL_FLASH_Unlock() function
 145:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   *         must be called before.
ARM GAS  /tmp/ccLTeI13.s 			page 4


 146:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   *         Call the @ref HAL_FLASH_Lock() to disable the flash memory access
 147:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   *         (recommended to protect the FLASH memory against possible unwanted operation)
 148:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   * @param[in]  pEraseInit pointer to an FLASH_EraseInitTypeDef structure that
 149:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   *         contains the configuration information for the erasing.
 150:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   *
 151:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   * @param[out]  PageError pointer to variable  that
 152:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   *         contains the configuration information on faulty page in case of error
 153:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   *         (0xFFFFFFFF means that all the pages have been correctly erased)
 154:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   *
 155:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   * @retval HAL_StatusTypeDef HAL Status
 156:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   */
 157:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** HAL_StatusTypeDef HAL_FLASHEx_Erase(FLASH_EraseInitTypeDef *pEraseInit, uint32_t *PageError)
 158:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** {
 159:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   HAL_StatusTypeDef status = HAL_ERROR;
 160:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   uint32_t address = 0U;
 161:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** 
 162:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   /* Process Locked */
 163:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   __HAL_LOCK(&pFlash);
 164:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** 
 165:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   /* Check the parameters */
 166:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   assert_param(IS_FLASH_TYPEERASE(pEraseInit->TypeErase));
 167:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** 
 168:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   if (pEraseInit->TypeErase == FLASH_TYPEERASE_MASSERASE)
 169:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   {
 170:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****       /* Mass Erase requested for Bank1 */
 171:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****       /* Wait for last operation to be completed */
 172:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****       if (FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE) == HAL_OK)
 173:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****       {
 174:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****         /*Mass erase to be done*/
 175:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****         FLASH_MassErase();
 176:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** 
 177:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****         /* Wait for last operation to be completed */
 178:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****         status = FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE);
 179:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c **** 
 180:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****         /* If the erase operation is completed, disable the MER Bit */
 181:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****         CLEAR_BIT(FLASH->CR, FLASH_CR_MER);
 182:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****       }
 183:Inc/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_flash_ex.c ****   }
