	(text "V_{ADJ} = (V_{DDB} - GND_DRV) * (R_{ADJ1}/R_{ADJ1}+R_{ADJ2})\nUVLO = 5V = 2 * (1 + R_{ADJ1}/R_{ADJ2})\nR_{ADJ1} = 20k\nR_{ADJ2} = (5/2 - 1) * 20k = 30k"
		(exclude_from_sim no)
		(at 101.6 91.948 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "94c93b35-db94-4d39-853d-3a07e18a16bc")
	)
